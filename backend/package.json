{
  "name": "haya-bila-alam-backend",
  "version": "1.0.0",
  "description": "Haya Bila Alam - Healthcare & Telemedicine Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "npx prisma generate --schema=prisma/schema",
    "db:migrate": "npx prisma migrate dev --schema=prisma/schema",
    "db:migrate:prod": "npx prisma migrate deploy --schema=prisma/schema",
    "db:push": "npx prisma db push --schema=prisma/schema",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:seed": "node prisma/seed.js",
    "db:seed:rbac": "node prisma/seed-rbac.js",
    "db:studio": "npx prisma studio --schema=prisma/schema",
    "db:reset": "npx prisma migrate reset --schema=prisma/schema",
    "test:rbac": "node tests/rbac/permission.service.test.js && node tests/rbac/authorization.matrix.test.js",
    "test:insurance": "node tests/insurance/insuranceRequest.orchestrator.test.js",
    "lint": "eslint src/",
    "swagger:generate": "node src/docs/generate.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
