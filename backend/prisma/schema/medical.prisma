model Speciality {
  id            Int      @id @default(autoincrement())
  nameAr        String   @db.VarChar(255)
  nameEn        String   @db.VarChar(255)
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  iconUrl       String?  @db.VarChar(500)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctors      DoctorProfile[]
  appointments Appointment[]   @relation("SpecialityAppointments")

  @@map("specialities")
}

model Service {
  id            Int         @id @default(autoincrement())
  nameAr        String      @db.VarChar(255)
  nameEn        String      @db.VarChar(255)
  descriptionAr String?     @db.Text
  descriptionEn String?     @db.Text
  type          ServiceType
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  doctorServices DoctorService[]
  appointments   Appointment[]   @relation("ServiceAppointments")

  @@map("services")
}

model DoctorService {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  serviceId Int
  createdAt DateTime @default(now())

  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceId])
  @@map("doctor_services")
}

model DoctorAvailability {
  id                  Int        @id @default(autoincrement())
  doctorId            Int
  dayOfWeek           DayOfWeek
  periodType          PeriodType
  startTime           String     @db.VarChar(5)
  endTime             String     @db.VarChar(5)
  slotDurationMinutes Int        @default(30)
  breakDurationMinutes Int       @default(5)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_availability")
}

model Appointment {
  id                       Int                    @id @default(autoincrement())
  patientId                Int
  familyMemberId           Int?
  doctorId                 Int
  specialityId             Int?
  serviceId                Int?
  appointmentType          AppointmentType         @default(CONSULTATION)
  appointmentDate          DateTime                @db.Date
  startTime                String                  @db.VarChar(5)
  endTime                  String                  @db.VarChar(5)
  status                   AppointmentStatus       @default(PENDING)
  insuranceStatus          InsurancePaymentStatus  @default(NOT_REQUIRED)
  paymentStatus            PaymentStatus           @default(PENDING)
  amount                   Decimal                 @default(0) @db.Decimal(10, 2)
  requiresInsuranceApproval Boolean                @default(false)
  approvedInsuranceCaseId  Int?
  notes                    String?                 @db.Text
  cancellationReason       String?                 @db.Text
  confirmedAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  createdBy                Int?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  patient       PatientProfile @relation("PatientAppointments", fields: [patientId], references: [id])
  familyMember  FamilyMember?  @relation("FamilyMemberAppointments", fields: [familyMemberId], references: [id])
  doctor        DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  speciality    Speciality?    @relation("SpecialityAppointments", fields: [specialityId], references: [id])
  service       Service?       @relation("ServiceAppointments", fields: [serviceId], references: [id])

  attachments    AppointmentAttachment[]
  insuranceCases InsuranceCase[]   @relation("AppointmentInsuranceCases")
  supportCases   SupportCase[]     @relation("AppointmentSupportCases")
  labTests       LabTestRequest[]
  conversation   Conversation?
  callSessions   CallSession[]
  prescriptions  Prescription[]
  reports        MedicalReport[]
  payments       Payment[]
  claimItems     ClaimItem[]
  reviews        Review[]
  doctorPayouts  DoctorPayout[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model AppointmentAttachment {
  id            Int            @id @default(autoincrement())
  appointmentId Int
  fileUrl       String         @db.VarChar(500)
  type          AttachmentType @default(DOCUMENT)
  uploadedBy    Int?
  createdAt     DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_attachments")
}

model MedicalFile {
  id            Int          @id @default(autoincrement())
  patientId     Int
  appointmentId Int?
  uploadedBy    Int
  category      FileCategory
  fileUrl       String       @db.VarChar(500)
  mimeType      String       @db.VarChar(100)
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([category])
  @@map("medical_files")
}

model LabTestRequest {
  id            Int           @id @default(autoincrement())
  appointmentId Int
  patientId     Int
  doctorId      Int
  title         String        @db.VarChar(255)
  notes         String?       @db.Text
  status        LabTestStatus @default(REQUESTED)
  requestedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("PatientLabTests", fields: [patientId], references: [id])
  doctor      DoctorProfile  @relation("DoctorLabTests", fields: [doctorId], references: [id])
  results     LabResult[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("lab_test_requests")
}

model LabResult {
  id               Int       @id @default(autoincrement())
  labTestRequestId Int
  uploadedBy       Int
  fileUrl          String    @db.VarChar(500)
  notes            String?   @db.Text
  reviewedByDoctor Boolean   @default(false)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  labTestRequest LabTestRequest @relation(fields: [labTestRequestId], references: [id], onDelete: Cascade)

  @@index([labTestRequestId])
  @@map("lab_results")
}

model Prescription {
  id               Int      @id @default(autoincrement())
  appointmentId    Int
  patientId        Int
  doctorId         Int
  diagnosis        String   @db.Text
  notes            String?  @db.Text
  qrCodeValue      String?  @db.VarChar(500)
  digitalSealValue String?  @db.Text
  pdfUrl           String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment Appointment        @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctor      DoctorProfile      @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  items       PrescriptionItem[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int    @id @default(autoincrement())
  prescriptionId Int
  medicineName   String @db.VarChar(255)
  dosage         String @db.VarChar(100)
  frequency      String @db.VarChar(100)
  duration       String @db.VarChar(100)
  instructions   String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model MedicalReport {
  id               Int      @id @default(autoincrement())
  appointmentId    Int
  patientId        Int
  doctorId         Int
  visitReason      String   @db.Text
  diagnosis        String   @db.Text
  summary          String?  @db.Text
  symptoms         String?  @db.Text
  clinicalFindings String?  @db.Text
  vitals           Json?
  recommendations  String?  @db.Text
  pdfUrl           String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("PatientReports", fields: [patientId], references: [id])
  doctor      DoctorProfile  @relation("DoctorReports", fields: [doctorId], references: [id])

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("medical_reports")
}

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  patientId     Int
  doctorId      Int
  rating        Int
  comment       String?  @db.Text
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("ReviewPatientProfile", fields: [patientId], references: [id], map: "reviews_patientProfileId_fkey")
  patientUser User           @relation("ReviewPatient", fields: [patientId], references: [id], map: "reviews_patientUserId_fkey")
  doctor      DoctorProfile  @relation("ReviewDoctor", fields: [doctorId], references: [id])

  @@unique([appointmentId, patientId])
  @@index([doctorId])
  @@map("reviews")
}
