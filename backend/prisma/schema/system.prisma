// System, Support, Communication and Payment Models

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum CallSessionType {
  VIDEO
  VOICE
}

enum CallSessionStatus {
  CREATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  MISSED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  WALLET
  INSURANCE
  CASH
  VISA
  MASTERCARD
  APPLE_PAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  APPOINTMENT
  INSURANCE
  PAYMENT
  SUPPORT
  SYSTEM
  CHAT
  LAB_RESULT
  PRESCRIPTION
  REPORT
  REVIEW
  VERIFICATION
  USER
}

enum NotificationSource {
  SYSTEM_EVENT
  ADMIN_MANUAL
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ESCALATE
  ASSIGN
  PAYMENT
  UPLOAD
  DOWNLOAD
}

// Communication Models

model Conversation {
  id            Int      @id @default(autoincrement())
  appointmentId Int?     @unique
  patientId     Int
  doctorId      Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("PatientConversations", fields: [patientId], references: [id])
  doctor      DoctorProfile  @relation("DoctorConversations", fields: [doctorId], references: [id])
  messages    Message[]

  @@index([patientId])
  @@index([doctorId])
  @@map("conversations")
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  senderId       Int
  messageType    MessageType @default(TEXT)
  content        String      @db.Text
  attachmentUrl  String?     @db.VarChar(500)
  sentAt         DateTime    @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// Call Session Model

model CallSession {
  id              Int               @id @default(autoincrement())
  appointmentId   Int
  patientId       Int
  doctorId        Int
  sessionType     CallSessionType
  provider        String            @default("mock") @db.VarChar(50)
  sessionId       String?           @db.VarChar(255)
  joinUrlPatient  String?           @db.VarChar(500)
  joinUrlDoctor   String?           @db.VarChar(500)
  status          CallSessionStatus @default(CREATED)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  appointment Appointment   @relation(fields: [appointmentId], references: [id])
  doctor      DoctorProfile @relation("DoctorCallSessions", fields: [doctorId], references: [id])

  @@index([appointmentId])
  @@map("call_sessions")
}

// Payment Models

model Payment {
  id                   Int           @id @default(autoincrement())
  appointmentId        Int?
  homeServiceRequestId Int?
  patientId            Int
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("SAR") @db.VarChar(3)
  method               PaymentMethod?
  provider             String?       @db.VarChar(50)
  transactionReference String?       @db.VarChar(255)
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  rawPayload           Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  appointment        Appointment?        @relation(fields: [appointmentId], references: [id])
  homeServiceRequest HomeServiceRequest? @relation("HomeServicePayments", fields: [homeServiceRequestId], references: [id])
  patient            PatientProfile      @relation("PatientPayments", fields: [patientId], references: [id])

  @@index([appointmentId])
  @@index([homeServiceRequestId])
  @@index([patientId])
  @@index([status])
  @@map("payments")
}

model DoctorPayout {
  id               Int          @id @default(autoincrement())
  doctorId         Int
  appointmentId    Int?
  grossAmount      Decimal      @db.Decimal(10, 2)
  commissionAmount Decimal      @db.Decimal(10, 2)
  netAmount        Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(PENDING)
  scheduledAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])

  @@index([doctorId])
  @@index([status])
  @@map("doctor_payouts")
}

// Notification Model

model Notification {
  id                Int                @id @default(autoincrement())
  userId            Int
  titleAr           String             @db.VarChar(500)
  titleEn           String             @db.VarChar(500)
  bodyAr            String             @db.Text
  bodyEn            String             @db.Text
  type              NotificationType
  source            NotificationSource @default(SYSTEM_EVENT)
  targetAudience    String?            @db.VarChar(100)
  createdByAdminId  Int?
  batchId           String?            @db.VarChar(36)
  isRead            Boolean            @default(false)
  readAt            DateTime?
  relatedEntityType String?            @db.VarChar(50)
  relatedEntityId   Int?
  createdAt         DateTime           @default(now())

  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByAdmin  User? @relation("AdminManualNotifications", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([source])
  @@index([batchId])
  @@map("notifications")
}

// System Settings Model

model SystemSetting {
  id        Int         @id @default(autoincrement())
  key       String      @unique @db.VarChar(255)
  value     String      @db.Text
  type      SettingType @default(STRING)
  isPublic  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("system_settings")
}

// Audit Log Model

model AuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int?
  entityType String      @db.VarChar(100)
  entityId   Int?
  action     AuditAction
  oldValues  Json?
  newValues  Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(500)
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Role and Permission Models

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(255)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}