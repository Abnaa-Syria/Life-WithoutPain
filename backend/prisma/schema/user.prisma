// User and Authentication Models

model User {
  id                Int        @id @default(autoincrement())
  fullName          String     @db.VarChar(255)
  email             String     @unique @db.VarChar(255)
  phone             String     @unique @db.VarChar(20)
  passwordHash      String     @db.VarChar(255)
  role              UserRole
  status            UserStatus @default(ACTIVE)
  isVerified        Boolean    @default(false)
  preferredLanguage String     @default("ar") @db.VarChar(5)
  darkModeEnabled   Boolean    @default(false)
  avatarUrl         String?    @db.VarChar(500)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  reviewsGiven    Review[]         @relation("ReviewPatient")
  sentMessages    Message[]        @relation("MessageSender")
  supportMessages SupportMessage[] @relation("SupportMessageSender")
  supportCasesCreated  SupportCase[] @relation("SupportCaseCreator")
  supportCasesAssigned SupportCase[] @relation("SupportAssignee")
  supportAttachmentsUploaded SupportAttachment[] @relation("SupportAttachmentUploader")
  supportContactInfoUpdates SupportContactInfo[] @relation("SupportContactInfoUpdater")

  verificationReviews DoctorVerificationDocument[] @relation("DocumentReviewer")
  insuranceDecisions  InsuranceApproval[]          @relation("InsuranceDecider")

  userPermissions UserPermission[]

  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String   @db.VarChar(10)
  purpose   String   @default("verification") @db.VarChar(50)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model UserPermission {
  id           Int     @id @default(autoincrement())
  userId       Int
  permissionId Int
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}