// Appointment, Medical Records, and Treatment Models

enum ServiceType {
  REMOTE
  HOME
  CLINIC
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum PeriodType {
  MORNING
  AFTERNOON
  EVENING
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum InsurancePaymentStatus {
  NOT_REQUIRED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  PARTIALLY_APPROVED
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  LAB_RESULT
  PRESCRIPTION
  REPORT
  OTHER
}

enum FileCategory {
  LAB_RESULT
  RADIOLOGY
  PRESCRIPTION
  MEDICAL_REPORT
  INSURANCE_DOCUMENT
  ID_DOCUMENT
  OTHER
}

enum LabTestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Appointment {
  id                       Int                    @id @default(autoincrement())
  patientId                Int
  familyMemberId           Int?
  doctorId                 Int
  specialityId             Int?
  serviceId                Int?
  appointmentType          AppointmentType         @default(CONSULTATION)
  appointmentDate          DateTime                @db.Date
  startTime                String                  @db.VarChar(5)
  endTime                  String                  @db.VarChar(5)
  status                   AppointmentStatus       @default(PENDING)
  insuranceStatus          InsurancePaymentStatus  @default(NOT_REQUIRED)
  paymentStatus            PaymentStatus           @default(PENDING)
  amount                   Decimal                 @default(0) @db.Decimal(10, 2)
  requiresInsuranceApproval Boolean                @default(false)
  approvedInsuranceCaseId  Int?
  notes                    String?                 @db.Text
  cancellationReason       String?                 @db.Text
  confirmedAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  createdBy                Int?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  patient       PatientProfile @relation("PatientAppointments", fields: [patientId], references: [id])
  familyMember  FamilyMember?  @relation("FamilyMemberAppointments", fields: [familyMemberId], references: [id])
  doctor        DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  speciality    Speciality?    @relation("SpecialityAppointments", fields: [specialityId], references: [id])
  service       Service?       @relation("ServiceAppointments", fields: [serviceId], references: [id])

  attachments    AppointmentAttachment[]
  insuranceCases InsuranceCase[]   @relation("AppointmentInsuranceCases")
  supportCases   SupportCase[]     @relation("AppointmentSupportCases")
  labTests       LabTestRequest[]
  conversation   Conversation?
  callSessions   CallSession[]
  prescriptions  Prescription[]
  reports        MedicalReport[]
  payments       Payment[]
  claimItems     ClaimItem[]
  reviews        Review[]
  doctorPayouts  DoctorPayout[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model AppointmentAttachment {
  id            Int            @id @default(autoincrement())
  appointmentId Int
  fileUrl       String         @db.VarChar(500)
  type          AttachmentType @default(DOCUMENT)
  uploadedBy    Int?
  createdAt     DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_attachments")
}

model MedicalFile {
  id            Int          @id @default(autoincrement())
  patientId     Int
  appointmentId Int?
  uploadedBy    Int
  category      FileCategory
  fileUrl       String       @db.VarChar(500)
  mimeType      String       @db.VarChar(100)
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([category])
  @@map("medical_files")
}

model LabTestRequest {
  id            Int           @id @default(autoincrement())
  appointmentId Int
  patientId     Int
  doctorId      Int
  title         String        @db.VarChar(255)
  notes         String?       @db.Text
  status        LabTestStatus @default(REQUESTED)
  requestedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("PatientLabTests", fields: [patientId], references: [id])
  doctor      DoctorProfile  @relation("DoctorLabTests", fields: [doctorId], references: [id])
  results     LabResult[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("lab_test_requests")
}

model LabResult {
  id               Int       @id @default(autoincrement())
  labTestRequestId Int
  uploadedBy       Int
  fileUrl          String    @db.VarChar(500)
  notes            String?   @db.Text
  reviewedByDoctor Boolean   @default(false)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  labTestRequest LabTestRequest @relation(fields: [labTestRequestId], references: [id], onDelete: Cascade)

  @@index([labTestRequestId])
  @@map("lab_results")
}

model Prescription {
  id               Int      @id @default(autoincrement())
  appointmentId    Int
  patientId        Int
  doctorId         Int
  diagnosis        String   @db.Text
  notes            String?  @db.Text
  qrCodeValue      String?  @db.VarChar(500)
  digitalSealValue String?  @db.Text
  pdfUrl           String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment Appointment        @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctor      DoctorProfile      @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  items       PrescriptionItem[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int    @id @default(autoincrement())
  prescriptionId Int
  medicineName   String @db.VarChar(255)
  dosage         String @db.VarChar(100)
  frequency      String @db.VarChar(100)
  duration       String @db.VarChar(100)
  instructions   String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model MedicalReport {
  id               Int      @id @default(autoincrement())
  appointmentId    Int
  patientId        Int
  doctorId         Int
  visitReason      String   @db.Text
  diagnosis        String   @db.Text
  summary          String?  @db.Text
  symptoms         String?  @db.Text
  clinicalFindings String?  @db.Text
  vitals           Json?
  clinicalExam     Json?
  nextAppointmentDate DateTime?
  recommendations  String?  @db.Text
  pdfUrl           String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment Appointment               @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile            @relation("PatientReports", fields: [patientId], references: [id])
  doctor      DoctorProfile             @relation("DoctorReports", fields: [doctorId], references: [id])
  attachments MedicalReportAttachment[]

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@map("medical_reports")
}

model MedicalReportAttachment {
  id        Int            @id @default(autoincrement())
  reportId  Int
  fileUrl   String         @db.VarChar(500)
  type      AttachmentType @default(DOCUMENT)
  createdAt DateTime       @default(now())

  report MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("medical_report_attachments")
}

model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  patientId     Int
  doctorId      Int
  rating        Int
  comment       String?  @db.Text
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment    @relation(fields: [appointmentId], references: [id])
  patient     PatientProfile @relation("ReviewPatientProfile", fields: [patientId], references: [id], map: "reviews_patientProfileId_fkey")
  patientUser User           @relation("ReviewPatient", fields: [patientId], references: [id], map: "reviews_patientUserId_fkey")
  doctor      DoctorProfile  @relation("ReviewDoctor", fields: [doctorId], references: [id])

  @@unique([appointmentId, patientId])
  @@index([doctorId])
  @@map("reviews")
}

model Medication {
  id          Int      @id @default(autoincrement())
  nameAr      String   @db.VarChar(255)
  nameEn      String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicalProfiles MedicalProfile[]

  @@map("medications")
}

model ChronicDisease {
  id          Int      @id @default(autoincrement())
  nameAr      String   @db.VarChar(255)
  nameEn      String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicalProfiles MedicalProfile[]

  @@map("chronic_diseases")
}

model Allergy {
  id          Int      @id @default(autoincrement())
  nameAr      String   @db.VarChar(255)
  nameEn      String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicalProfiles MedicalProfile[]

  @@map("allergies")
}

model MedicalTest {
  id          Int      @id @default(autoincrement())
  nameAr      String   @db.VarChar(255)
  nameEn      String   @db.VarChar(255)
  categoryAr  String?  @db.VarChar(100)
  categoryEn  String?  @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("medical_tests")
}