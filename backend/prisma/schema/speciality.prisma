// Medical Services and Specialities Models

model Speciality {
  id            Int      @id @default(autoincrement())
  nameAr        String   @db.VarChar(255)
  nameEn        String   @db.VarChar(255)
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  iconUrl       String?  @db.VarChar(500)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctors      DoctorProfile[]
  appointments Appointment[]   @relation("SpecialityAppointments")

  @@map("specialities")
}

model Service {
  id            Int         @id @default(autoincrement())
  nameAr        String      @db.VarChar(255)
  nameEn        String      @db.VarChar(255)
  descriptionAr String?     @db.Text
  descriptionEn String?     @db.Text
  type          ServiceType
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  doctorServices      DoctorService[]
  appointments        Appointment[]        @relation("ServiceAppointments")
  homeServiceRequests HomeServiceRequest[] @relation("ServiceHomeServiceRequests")

  @@map("services")
}

model DoctorService {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  serviceId Int
  createdAt DateTime @default(now())

  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceId])
  @@map("doctor_services")
}

model DoctorAvailability {
  id                  Int        @id @default(autoincrement())
  doctorId            Int
  dayOfWeek           DayOfWeek
  periodType          PeriodType
  startTime           String     @db.VarChar(5)
  endTime             String     @db.VarChar(5)
  slotDurationMinutes Int        @default(30)
  breakDurationMinutes Int       @default(5)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_availability")
}