# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database
DATABASE_URL="mysql://root:password@localhost:3306/haya_bila_alam"

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Storage (local | s3)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment Provider (mock | tap | moyasar)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Video Provider (mock | agora | jitsi)
VIDEO_PROVIDER=mock
VIDEO_APP_ID=
VIDEO_APP_CERTIFICATE=

# Insurance Integration (mock | nafis)
INSURANCE_PROVIDER=mock
INSURANCE_API_URL=
INSURANCE_API_KEY=

# OTP Provider (mock | twilio | unifonic)
OTP_PROVIDER=mock
OTP_API_KEY=
OTP_SENDER_ID=

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
