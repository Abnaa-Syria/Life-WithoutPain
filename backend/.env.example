# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database Connection
DATABASE_URL=""

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_PROVIDER=mock
OTP_STUB_CODE=12345
OTP_ALLOW_STUB=true

# Uploads & Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=local

# AWS S3 Storage
AWS_S3_BUCKET=your_s3_bucket
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Payment Provider Integration
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Video Call Integration
VIDEO_PROVIDER=mock
VIDEO_APP_ID=your_video_app_id
VIDEO_APP_CERTIFICATE=your_video_app_certificate

# Insurance Provider Integration
INSURANCE_PROVIDER=mock
INSURANCE_API_URL=https://api.insurance-provider.com
INSURANCE_API_KEY=your_insurance_api_key

# Rate Limiting (applied only when NODE_ENV=production)
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Application Specific
PATIENT_COMING_WINDOW_HOURS=24
